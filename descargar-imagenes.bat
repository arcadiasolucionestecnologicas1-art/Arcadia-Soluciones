@echo off
REM Descarga las fotografias de Unsplash (ya en formato WebP y tamano optimizado) a la carpeta img.
REM Uso: doble clic en este archivo. Requiere Windows 10 u 11 (incluye curl).
cd /d "%~dp0"
if not exist img mkdir img
echo Descargando img/hero.webp ...
curl -L --fail -s -o "img\hero.webp" "https://images.unsplash.com/photo-1522071820081-009f0129c71c?fm=webp&q=72&w=920&h=1150&fit=crop"
echo Descargando img/diseno-web.webp ...
curl -L --fail -s -o "img\diseno-web.webp" "https://images.unsplash.com/photo-1549692520-acc6669e2f0c?fm=webp&q=72&w=1000&h=750&fit=crop"
echo Descargando img/reunion.webp ...
curl -L --fail -s -o "img\reunion.webp" "https://images.unsplash.com/photo-1521737852567-6949f3f9f2b5?fm=webp&q=72&w=1000&h=625&fit=crop"
echo Descargando img/equipo.webp ...
curl -L --fail -s -o "img\equipo.webp" "https://images.unsplash.com/photo-1629904853893-c2c8981a1dc5?fm=webp&q=72&w=1000&h=750&fit=crop"
echo Descargando img/cafeteria.webp ...
curl -L --fail -s -o "img\cafeteria.webp" "https://images.unsplash.com/photo-1753351052363-53ce102830eb?fm=webp&q=72&w=640&h=800&fit=crop"
echo Descargando img/tienda.webp ...
curl -L --fail -s -o "img\tienda.webp" "https://images.unsplash.com/photo-1762471712594-eadf362e7d0f?fm=webp&q=72&w=640&h=800&fit=crop"
echo Descargando img/emprendimiento.webp ...
curl -L --fail -s -o "img\emprendimiento.webp" "https://images.unsplash.com/photo-1753161029353-f6bb0ff2ad3c?fm=webp&q=72&w=640&h=800&fit=crop"
echo.
echo Listo. Abre index.html para ver la pagina con las fotos.
pause
